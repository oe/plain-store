{
  "name": "plain-store",
  "version": "0.9.0",
  "description": "A simple immutable store management for React",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn test && yarn build && yarn test:package",
    "test:package": "node scripts/test-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oe/plain-store"
  },
  "author": {
    "name": "Saiya",
    "email": "me@evecalm.com"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "store",
    "state",
    "management",
    "redux"
  ],
  "devDependencies": {
    "@preact/signals-react": "^3.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.2.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "packageManager": "yarn@1.22.22"
}
