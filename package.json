{
  "name": "plain-store",
  "version": "0.10.1",
  "description": "A tiny React state store with get/set APIs and deep-equal selectors",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "prepublishOnly": "npm test && npm run build && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "benchmark:selectors": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/benchmark-selectors.mjs",
    "benchmark:compare": "npm run build && npm ci --prefix benchmarks --ignore-scripts --legacy-peer-deps && node benchmarks/compare.mjs",
    "benchmark:check": "npm ci --prefix benchmarks --ignore-scripts --legacy-peer-deps && node benchmarks/compare.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oe/plain-store"
  },
  "author": {
    "name": "Saiya",
    "email": "me@evecalm.com"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "store",
    "state",
    "state-management",
    "react-state",
    "global-state",
    "selector",
    "typescript",
    "lightweight",
    "immutable"
  ],
  "devDependencies": {
    "@preact/signals-react": "^3.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.2.2",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "homepage": "https://github.com/oe/plain-store#readme",
  "sideEffects": [
    "./dist/iife/index.js"
  ]
}
